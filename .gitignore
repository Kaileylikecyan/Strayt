# ---- Node / 前端 ----
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
.eslintcache

# ---- Tauri / Rust ----
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
# Cargo.lock **要入库**：这是可执行应用（不是库），锁住依赖版本才能保证
# 「同一份代码 → 同一个 exe」。本机走 rsproxy 镜像，锁文件里全是
# crates.io 的 registry 源，别的机器照着锁文件拉即可，不必本地有镜像。
**/*.rs.bk

# ---- Python / uv ----
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ---- 运行时数据（不进仓库） ----
server/var/
!server/var/.gitkeep
# 测试用的 data_dir，测试跑完会留分片残留
server/var_test/
data/
storage/
*.db
*.db-journal
*.db-wal
*.db-shm
.env
.env.local

# ---- 大文件：真实样板资料不入库 ----
# 参考解析结果里含材料全文，等同于一份副本，一并排除
server/fixtures/*.pdf
server/fixtures/*.docx
server/fixtures/*.jpg
server/fixtures/*.png
server/fixtures/*.json
!server/fixtures/README.md

# ---- 备份产物 ----
backup/
*.sql
*.sql.gz

# ---- 编辑器 / 系统 ----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini
