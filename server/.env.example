# 服务端环境变量模板。复制为 .env 后按需修改；.env 不要提交。
# 所有变量前缀 STRAYT_，见 server/app/core/config.py

STRAYT_DATA_DIR=var
STRAYT_DB_URL=mysql+pymysql://strayt:CHANGE_ME@127.0.0.1:3306/strayt?charset=utf8mb4
# 访问口令用 Argon2id 哈希，无需 pepper。口令本身不进配置：
# 首次接入时在客户端创建，或 `uv run python -m app.scripts.set_password`。
STRAYT_SECRET_KEY=CHANGE_ME
STRAYT_DEBUG=false
STRAYT_SERVER_NAME=strayt
